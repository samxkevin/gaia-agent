COHERE_PRIMARY_API_KEY=
COHERE_FALLBACK_API_KEY=

COHERE_PRIMARY_MODEL=command-a-plus-05-2026
COHERE_FALLBACK_MODEL=command-a-reasoning-08-2025
COHERE_VISION_MODEL=command-a-vision-07-2025

COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1

COHERE_PRIMARY_TRANSCRIPTION_MODEL=cohere-transcribe-03-2026
COHERE_FALLBACK_TRANSCRIPTION_MODEL=cohere-transcribe-03-2026

HF_TOKEN=
HF_USERNAME=
GAIA_API_URL=https://agents-course-unit4-scoring.hf.space
AGENT_CODE_URL=https://huggingface.co/spaces/YOUR_USERNAME/YOUR_SPACE

MAX_AGENT_STEPS=18
PLANNING_INTERVAL=5
WEB_MAX_RESULTS=8
WEB_RATE_LIMIT=1.0
MAX_TOOL_TEXT=100000
MAX_WEBPAGE_TEXT=15000

FAILOVER_ATTEMPTS=4
FAILOVER_COOLDOWN_SECONDS=45
MODEL_MAX_RETRIES=0
MODEL_TIMEOUT_SECONDS=120

# Free tier only. Adversal is skipped automatically when quota is
# unavailable, insufficient, or authentication is missing.
ADVERSAL_ENABLED=true
ADVERSAL_CLI_PACKAGE=adversal-cli==0.1.4
ADVERSAL_TIMEOUT_SECONDS=300
ADVERSAL_POLL_SECONDS=10

# Optional: point to an already installed adversal-cli executable.
# ADVERSAL_CLI=C:\path\to\adversal-cli.exe

# Legacy single key support:
# COHERE_API_KEY can be used as the primary key if needed.
